<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elias "Eli" Thompson | Portfolio</title>
  <style>
    :root { --navy:#0b2f5b; --blue:#155fa0; --gold:#f0b323; --text:#f5f7fb; --muted:#c9d5e5; --line:rgba(255,255,255,.12); --card:rgba(255,255,255,.06); }
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Arial,Helvetica,sans-serif;background:radial-gradient(circle at top right, rgba(21,95,160,.25), transparent 28%),radial-gradient(circle at bottom left, rgba(240,179,35,.18), transparent 24%),linear-gradient(180deg,#08111d 0%,#0a1f37 100%);color:var(--text)} a{text-decoration:none;color:inherit}
    .topbar{position:sticky;top:0;z-index:20;backdrop-filter:blur(10px);background:rgba(7,23,38,.88);border-bottom:1px solid var(--line)} .container{width:min(1180px,calc(100% - 32px));margin:0 auto}
    .nav{display:flex;justify-content:space-between;align-items:center;padding:16px 0;gap:16px}.brand h1{margin:0;font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}.brand p{margin:3px 0 0;font-size:13px;color:var(--muted)}.nav-links{display:flex;gap:18px;flex-wrap:wrap;font-size:14px;color:var(--muted)}
    .hero{position:relative;overflow:hidden;padding:80px 0 40px}.hero:before{content:"P";position:absolute;left:-10px;top:140px;font-size:240px;font-weight:900;color:rgba(255,255,255,.04)}.hero:after{content:"🏀";position:absolute;right:70px;top:120px;font-size:140px;opacity:.08}
    .hero-grid,.projects-grid,.two-grid,.three-grid,.skills-grid,.modal-grid{display:grid;gap:18px}.hero-grid{grid-template-columns:1.2fr .85fr;gap:30px}.projects-grid{grid-template-columns:repeat(2,1fr)}.two-grid{grid-template-columns:repeat(2,1fr)}.three-grid{grid-template-columns:repeat(3,1fr)}.skills-grid{grid-template-columns:repeat(4,1fr)}
    .pill{display:inline-block;padding:10px 14px;border-radius:999px;background:rgba(240,179,35,.12);border:1px solid rgba(240,179,35,.28);color:#f6d477;font-size:13px;font-weight:700}.hero h2{font-size:clamp(40px,7vw,72px);line-height:.98;margin:18px 0 16px}.hero h2 span{color:var(--gold)}.lead{max-width:760px;color:var(--muted);font-size:19px;line-height:1.7}
    .btn-row,.tags,.tool-row{display:flex;gap:10px;flex-wrap:wrap}.btn-row{margin-top:28px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 18px;border-radius:16px;font-weight:700;border:1px solid transparent;transition:.2s ease;cursor:pointer}.btn:hover{transform:translateY(-2px)}.btn-primary{background:var(--gold);color:#101621}.btn-secondary{background:rgba(255,255,255,.05);color:#fff;border-color:var(--line)}
    .tag,.tool{padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid var(--line);font-size:13px}.panel,.card,.modal-card{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:22px}.panel{border-radius:28px;box-shadow:0 18px 50px rgba(0,0,0,.18)}.panel-title{display:flex;gap:12px;align-items:center;margin-bottom:18px}.icon{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:rgba(255,255,255,.08);font-size:22px}.stat{background:rgba(0,0,0,.18);border:1px solid var(--line);border-radius:20px;padding:16px;margin-bottom:14px}.label{font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:#98afc9;margin-bottom:8px}.value{font-size:15px;line-height:1.6;font-weight:700}
    section{padding:34px 0}.section-top{margin-bottom:24px}.eyebrow{color:var(--gold);text-transform:uppercase;letter-spacing:.24em;font-size:12px;font-weight:700;margin-bottom:10px}.section-top h3{margin:0;font-size:clamp(28px,4vw,42px)}.section-top p,.card p,.card li,.modal-card p,.modal-card li{color:var(--muted);line-height:1.8}.card h4,.modal-card h5{margin:0 0 12px}.skill{text-align:center;font-weight:700;padding:18px 12px}.project-card{cursor:pointer;transition:.2s ease;overflow:hidden}.project-card:hover{transform:translateY(-4px)}.project-top{height:6px;margin:-22px -22px 18px;background:linear-gradient(90deg,var(--navy),var(--blue),var(--gold))}.project-icon{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,.06);font-size:24px;margin-bottom:14px}.view-link{color:#f8cb58;font-weight:700;font-size:14px;margin-top:8px;display:inline-block} ul.clean{padding-left:18px;margin:0}
    .resume-box{background:linear-gradient(145deg,rgba(11,47,91,.7),rgba(7,23,38,.95))}.contact-link{display:flex;gap:10px;align-items:center;margin:12px 0;color:#fff;font-weight:600} footer{border-top:1px solid var(--line);padding:28px 0 36px;text-align:center;color:#a8bfd9;font-size:14px}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;padding:18px;z-index:40;backdrop-filter:blur(8px)}.modal.active{display:flex}.modal-box{width:min(1120px,100%);max-height:92vh;overflow:hidden;background:#08192d;border:1px solid var(--line);border-radius:28px;box-shadow:0 24px 60px rgba(0,0,0,.35)}.modal-header{padding:28px;background:linear-gradient(90deg,var(--navy),var(--blue),#d09b1e);position:relative}.close{position:absolute;right:18px;top:18px;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.1);color:#fff;font-size:20px;cursor:pointer}.modal-header h4{margin:0 44px 10px 0;font-size:clamp(28px,5vw,44px)}.modal-body{padding:24px;overflow-y:auto;max-height:calc(92vh - 150px)}.modal-grid{grid-template-columns:1.2fr .8fr}.action-btn{display:block;width:100%;margin-bottom:12px;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid var(--line);color:#fff;font-weight:700;text-align:left} pre{white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,.28);border:1px solid var(--line);color:#d8e9ff;border-radius:16px;padding:14px;font-size:13px;line-height:1.7;overflow:auto}
    @media (max-width:960px){.hero-grid,.projects-grid,.two-grid,.three-grid,.skills-grid,.modal-grid{grid-template-columns:1fr}.hero:after{right:18px;top:70px;font-size:96px}.hero:before{font-size:180px;top:190px}}
  </style>
</head>
<body>
  <div class="topbar"><div class="container nav"><div class="brand"><h1>Elias “Eli” Thompson</h1><p>Business Analytics Portfolio</p></div><div class="nav-links"><a href="#home">Home</a><a href="#about">About</a><a href="#projects">Projects</a><a href="#skills">Skills</a><a href="#resume">Resume</a><a href="#contact">Contact</a></div></div></div>
  <section id="home" class="hero"><div class="container hero-grid"><div><div class="pill">Seton Hall inspired • basketball energy • blue & gold theme</div><h2>Elias <span>“Eli”</span> Thompson</h2><p class="lead">Business Analytics student at Seton Hall University focused on using Excel, SQL, Python, Tableau, Adobe Express, and AI-assisted analysis to turn data into clear business insights.</p><div class="btn-row"><a class="btn btn-primary" href="#projects">View My Projects</a><a class="btn btn-secondary" href="Eli_Thompson_Resume_and_Cover_Letter.pdf" target="_blank">Download Resume</a></div><div class="tags"><span class="tag">Excel</span><span class="tag">VBA</span><span class="tag">SQL</span><span class="tag">Python</span><span class="tag">Tableau</span><span class="tag">Adobe Express</span><span class="tag">Data Visualization</span><span class="tag">AI-Assisted Analysis</span></div></div><div class="panel"><div class="panel-title"><div class="icon">🎓</div><div><div style="font-size:12px;color:#f0b323;text-transform:uppercase;letter-spacing:.2em;font-weight:700;">Quick Snapshot</div><div style="font-size:22px;font-weight:800;">Student Analyst Profile</div></div></div><div class="stat"><div class="label">Projects</div><div class="value">5 portfolio projects across Excel, SQL, Python, Tableau, and Adobe Express</div></div><div class="stat"><div class="label">Core Tools</div><div class="value">Excel • VBA • SQL • Python • Tableau • Adobe Express</div></div><div class="stat"><div class="label">Focus</div><div class="value">Business analytics, strategy, operations, dashboards, and clear presentation of insights</div></div><div class="stat"><div class="label">Goal</div><div class="value">Internships in analytics, strategy, operations, and business-focused data roles</div></div></div></div></section>
  <section id="about"><div class="container"><div class="section-top"><div class="eyebrow">About Me</div><h3>Analytics with a business mindset</h3><p>I like taking complex information and turning it into something clear, useful, and easy to present. My portfolio combines technical tools with business thinking, communication, and data storytelling.</p></div><div class="three-grid"><div class="card"><h4>Who I Am</h4><p>I am a Business Analytics student at Seton Hall University with experience in Excel, VBA, SQL, Python, Tableau, and business reporting. I enjoy projects that turn raw data into insights people can actually use.</p></div><div class="card"><h4>What I Focus On</h4><p>My main focus is using analytics to support decisions in strategy, operations, customer insights, and business development. I care about both the technical side and the presentation side of analytics.</p></div><div class="card"><h4>How I Work</h4><p>I use AI as a support tool for brainstorming, debugging, and organizing my process, but I make sure I still understand the work, explain the results clearly, and connect them back to real business value.</p></div></div></div></section>
  <section id="projects"><div class="container"><div class="section-top"><div class="eyebrow">Projects</div><h3>Portfolio work</h3><p>Each project shows a different part of my business analytics toolkit. Click any project to open a popup with the full explanation, what it does step by step, and how to access the file.</p></div><div class="projects-grid" id="projectGrid"></div></div></section>
  <section id="skills"><div class="container"><div class="section-top"><div class="eyebrow">Skills</div><h3>Tools and strengths</h3><p>A mix of technical tools, presentation skills, and business-focused analysis.</p></div><div class="skills-grid"><div class="card skill">Excel</div><div class="card skill">VBA</div><div class="card skill">SQL</div><div class="card skill">Python</div><div class="card skill">Tableau</div><div class="card skill">Adobe Express</div><div class="card skill">Dashboards</div><div class="card skill">Business Analysis</div><div class="card skill">Data Visualization</div><div class="card skill">AI-Assisted Analysis</div><div class="card skill">Reporting</div><div class="card skill">Communication</div></div></div></section>
  <section id="resume"><div class="container"><div class="section-top"><div class="eyebrow">Resume</div><h3>Education, experience, and project background</h3><p>My resume is available to download directly from this portfolio.</p></div><div class="two-grid"><div class="card"><h4>Highlights</h4><ul class="clean"><li>Business Analytics student at Seton Hall University with a 3.5 GPA.</li><li>Relevant coursework includes Information Management Systems, Business Statistics, Finite Calculus, Advanced Business Software Tools & VBA, Money and Banking, Business Ethics, Business Writing, and Speaking and Listening in the Digital Age.</li><li>Technical background includes Excel, VBA, SQL, Python, Tableau, Adobe Express, dashboards, reporting, and communication of insights.</li><li>Work experience includes Best Buy cashier experience with customer service, transactions, and support for front-end goals.</li></ul></div><div class="card resume-box"><h4>Resume + Cover Letter</h4><p>This file includes my current resume and cover letter materials. It can be downloaded and shared directly.</p><div class="btn-row"><a class="btn btn-primary" href="Eli_Thompson_Resume_and_Cover_Letter.pdf" target="_blank">Download Resume PDF</a></div></div></div></div></section>
  <section id="contact"><div class="container"><div class="section-top"><div class="eyebrow">Contact</div><h3>Let’s connect</h3><p>Open to opportunities in business analytics, strategy, operations, and data-focused internships.</p></div><div class="two-grid"><div class="card"><h4>Contact Information</h4><a class="contact-link" href="mailto:eliasthompson10567@gmail.com">📧 eliasthompson10567@gmail.com</a><a class="contact-link" href="https://www.linkedin.com/in/elias-thompson-22463032b/" target="_blank">💼 LinkedIn Profile</a></div><div class="card"><h4>Portfolio Message</h4><p>Thanks for checking out my portfolio. This site reflects the way I like to work: take a real business question, use the right tools, organize the information clearly, and present it in a way that people can actually understand and use.</p></div></div></div></section>
  <footer>Built for Elias “Eli” Thompson • Business Analytics Portfolio</footer>
  <div class="modal" id="projectModal"><div class="modal-box"><div class="modal-header"><button class="close" id="closeModal">×</button><h4 id="modalTitle"></h4><p id="modalShort"></p></div><div class="modal-body"><div class="modal-grid"><div><div class="modal-card"><h5>Project Overview</h5><p id="modalOverview"></p></div><div class="modal-card"><h5>What This Project Does</h5><ul class="clean" id="modalDid"></ul></div><div class="modal-card"><h5>What I Understand About It</h5><ul class="clean" id="modalKnow"></ul></div><div class="modal-card"><h5>Business Value</h5><ul class="clean" id="modalValue"></ul></div><div class="modal-card"><h5>Basic Example / Snippet</h5><pre id="modalCode"></pre></div></div><div><div class="modal-card"><h5>Project Access</h5><div id="modalButtons"></div></div><div class="modal-card"><h5>Step-by-Step Access / Run Instructions</h5><ol id="modalSteps"></ol></div><div class="modal-card"><h5>Why This Helps My Portfolio</h5><p>This project helps show employers that I can connect analytics tools to real business problems, explain my work clearly, and use AI as a support tool while still understanding the project myself.</p></div></div></div></div></div></div>
  <script>
    const projects=[{title:"AI-Assisted Sales Performance Analyzer",short:"A beginner-friendly Python project that turns raw sales data into clear business insights using pandas and matplotlib.",icon:"💻",tools:["Python","pandas","matplotlib","CSV","Excel"],overview:"I built this project to show that I can use basic Python for real business analysis. The script reads a sales dataset, calculates useful KPIs, identifies top performers, and creates charts that make the results easier to understand.",did:["Created and organized a realistic sales dataset in CSV and Excel format.","Wrote beginner-level Python code to read the file and calculate total sales, average order value, total units sold, top product, top region, and top sales rep.","Generated simple charts for monthly sales trends and regional sales performance.","Used AI as a coding assistant to improve structure, troubleshoot errors, and keep the project organized while still learning what each line does."],know:["How pd.read_csv() loads a CSV file into a dataframe.","How .sum(), .mean(), and .groupby() are used to calculate KPIs.","How idxmax() finds the best-performing category.","How simple bar charts can show trends and comparisons clearly.","How to explain the business meaning behind the output, not just the code itself."],value:["Shows how data can be turned into decisions around products, regions, and sales performance.","Demonstrates beginner Python knowledge in a business context.","Highlights my ability to use AI responsibly to improve workflow rather than replace my own thinking."],steps:["Click Download Python Script if you want the code file.","Click Download Sales CSV for the main dataset.","Open the CSV and script in the same folder if you want to run it yourself.","Install pandas and matplotlib if needed.","Run the script to print the KPIs and generate the charts."],code:`import pandas as pd\nimport matplotlib.pyplot as plt\n\ndf = pd.read_csv("sales_data.csv")\ntotal_sales = df["Sales"].sum()\naverage_order_value = df["Sales"].mean()\ntop_product = df.groupby("Product")["Sales"].sum().idxmax()`,buttons:[{label:"Download Python Script",href:"sales_analyzer.py"},{label:"Download Sales CSV",href:"sales_data.csv"},{label:"Download Sales Excel File",href:"sales_data.xlsx"}]},{title:"AI Adoption and Business Impact Analysis",short:"An Excel workbook that analyzes how AI adoption affects business performance across industries, functions, and company types.",icon:"📊",tools:["Excel","Dashboards","KPIs","Business Analysis"],overview:"This project analyzes how companies across different industries are adopting AI and where that adoption is creating measurable business value. The workbook is organized to show the full flow of an analytics project, from a project overview and dataset to dashboard analysis, chart-ready outputs, and a presentation-style executive summary.",did:["Worked with a structured business dataset focused on AI adoption, business function, company traits, and performance outcomes.","Organized the workbook into clear sections including Executive Summary, Overview, Dataset, Analysis Dashboard, Project Guide, and Chart Data.","Used Excel to compare trends across industries and AI functions, helping show where AI had stronger effects on performance and business impact.","Presented the project like a real business analytics deliverable by focusing on findings, organization, and clarity instead of just raw data."],know:["How to structure an Excel project so it moves from raw data to analysis to clear findings.","How KPI summaries and dashboard sections help make data easier to understand.","How AI adoption can be evaluated through business categories like industry, operations, marketing, and performance.","How to organize a workbook so it is usable for both analysis and presentation."],value:["Shows Excel-based analytics skills in a modern and relevant business topic.","Demonstrates my ability to connect data to strategy, operations, and business decision-making.","Highlights that I can present findings in a clean and professional way, not just build a dataset."],steps:["Click Download Excel Workbook.","Open the file in Microsoft Excel.","Start with the Executive_Summary sheet to understand the main findings.","Use the Overview sheet to understand the purpose and structure of the project.","Review the Dataset, Analysis_Dashboard, and Chart_Data sheets to follow the analysis step by step."],code:`Workbook sections:\n- Executive_Summary\n- Overview\n- Dataset\n- Analysis_Dashboard\n- Project_Guide\n- Chart_Data\n\nMain focus:\n- AI adoption by industry\n- business impact comparisons\n- dashboard summaries\n- clear presentation of findings`,buttons:[{label:"Download Excel Workbook",href:"Eli AI Adoption Business impact project.xlsx"}]},{title:"SQL Customer Segmentation Project",short:"A SQLite project focused on customer analysis, segmentation, repeat purchasing, and revenue insights.",icon:"🗄️",tools:["SQLite","SQL","Customer Analytics","Segmentation"],overview:"This project shows my understanding of basic SQL and business-focused querying. The goal was to analyze customer behavior and revenue patterns by segment so I could answer questions that matter to a business, such as who the top customers are and which channels drive the most value.",did:["Built and used a SQLite database for customer segmentation analysis.","Created queries around top customers, customer lifetime value, repeat customers, revenue by segment, and revenue by channel.","Focused the project on business questions rather than overly technical database work.","Designed the project so it could be downloaded and opened directly in SQLite for review."],know:["How SELECT, GROUP BY, SUM, COUNT, and basic filtering help answer business questions.","How segmentation helps businesses understand customer value and behavior.","How SQL can support reporting, marketing analysis, and customer strategy.","How to explain the results of a query in business language."],value:["Shows that I can work with databases at a basic but useful business level.","Demonstrates practical customer analytics thinking.","Adds SQL to my portfolio alongside Excel, Python, and Tableau."],steps:["Click Download SQLite Database.","Save the .db file to your computer.","Open DB Browser for SQLite or SQLiteStudio.","Choose Open Database and select the downloaded file.","Use Browse Data or Execute SQL to review the project."],code:`SELECT Segment, SUM(Revenue) AS Total_Revenue\nFROM customers\nGROUP BY Segment\nORDER BY Total_Revenue DESC;`,buttons:[{label:"Download SQLite Database",href:"SQLite Customer Segmentation project.db"}]},{title:"Business Data Visualization Project",short:"A Tableau + Adobe Express project that turns public data into easy-to-understand insights for non-technical audiences.",icon:"📈",tools:["Tableau","Adobe Express","PolicyMap","Data Storytelling"],overview:"This project highlights my ability to find real data, decide which visuals make the most sense, and present findings clearly. I gathered online datasets, used Tableau to build charts, and then presented the insights in Adobe Express so the information would be easier for non-technical viewers to follow.",did:["Sourced real datasets online, including information from platforms like PolicyMap.","Used Tableau to create visuals that matched the questions I wanted to answer.","Chose chart types based on what would communicate comparisons, trends, and patterns most clearly.","Presented the final insights in Adobe Express so the results were easy to understand and visually engaging."],know:["How to choose the right chart depending on the question being asked.","How to turn raw public data into a cleaner story with clear visuals.","How to present data to non-technical audiences in a simple, professional way.","How data storytelling matters just as much as technical analysis."],value:["Shows strong communication and presentation ability.","Demonstrates that I understand how to make analytics useful to decision-makers.","Strengthens my portfolio with data storytelling and visualization skills."],steps:["Click Open Adobe Express Project.","The project opens directly in your browser.","Review how the data is presented visually and explained clearly.","Use this project to see how I translate data into a simple story for non-technical viewers."],code:`Main focus:\n- sourcing public data\n- creating Tableau visuals\n- selecting chart types intentionally\n- presenting insights clearly in Adobe Express`,buttons:[{label:"Open Adobe Express Project",href:"https://new.express.adobe.com/webpage/HJvjBVdumeUth",external:true}]},{title:"Auto Purchase Cost Analysis Model",short:"An Excel assumptions-based model that compares vehicle ownership costs using formulas, lookup logic, and decision rules.",icon:"🚗",tools:["Excel","IF","OR","VLOOKUP","Assumptions Modeling"],overview:"This Excel model compares the estimated ownership cost of different vehicles by using a structured assumptions section and formula-based logic. Instead of only listing car prices, the file calculates gas usage, fuel cost, maintenance cost, premium gas requirements, insurance-related logic, and driver classification in a way that updates automatically when assumptions change.",did:["Worked with a vehicle comparison model that included cars with different prices, MPG values, and vehicle types.","Used an assumptions section to drive outputs such as annual mileage, gas pricing, premium fuel rules, insurance logic, and loan-related inputs.","Applied Excel formulas to calculate gallons used, gas cost, maintenance totals, and decision-based labels.","Built the model so that changing assumptions updates the cost outputs dynamically."],know:["How IF statements are used for business decision logic.","How OR can be combined with IF when more than one condition matters.","How VLOOKUP can pull values from an assumptions table instead of typing them manually.","How multiplication and division formulas support cost calculations like fuel use and maintenance totals.","How assumptions make a spreadsheet model more flexible and realistic."],value:["Shows my understanding of basic Excel formulas learned in class.","Demonstrates assumption-based modeling and dynamic spreadsheet thinking.","Adds another practical Excel project to my portfolio beyond dashboards and summaries."],steps:["Click Download Auto Purchase Excel File.","Open the workbook in Microsoft Excel.","Review the vehicle comparison section at the top of the sheet.","Look at the assumptions section to see which inputs drive the model.","Change an assumption like annual mileage or gas price and watch the outputs update."],code:`Basic Excel formulas used:\n- IF()\n- OR()\n- VLOOKUP()\n- multiplication\n- division\n\nModel idea:\n- assumptions drive calculations\n- calculations update automatically when assumptions change`,buttons:[{label:"Download Auto Purchase Excel File",href:"Eli Thompson Auto Purchase File.xlsx"}]}];
    const projectGrid=document.getElementById('projectGrid'),modal=document.getElementById('projectModal'),closeModal=document.getElementById('closeModal');
    const modalTitle=document.getElementById('modalTitle'),modalShort=document.getElementById('modalShort'),modalOverview=document.getElementById('modalOverview'),modalDid=document.getElementById('modalDid'),modalKnow=document.getElementById('modalKnow'),modalValue=document.getElementById('modalValue'),modalCode=document.getElementById('modalCode'),modalButtons=document.getElementById('modalButtons'),modalSteps=document.getElementById('modalSteps');
    function fillList(el,items){el.innerHTML='';items.forEach(item=>{const li=document.createElement('li');li.textContent=item;el.appendChild(li);});}
    function openProject(project){modalTitle.textContent=project.title;modalShort.textContent=project.short;modalOverview.textContent=project.overview;fillList(modalDid,project.did);fillList(modalKnow,project.know);fillList(modalValue,project.value);modalCode.textContent=project.code;modalButtons.innerHTML='';project.buttons.forEach(button=>{const a=document.createElement('a');a.className='action-btn';a.textContent=button.label;a.href=button.href;if(button.external){a.target='_blank';a.rel='noreferrer';}modalButtons.appendChild(a);});modalSteps.innerHTML='';project.steps.forEach(step=>{const li=document.createElement('li');li.style.marginBottom='10px';li.textContent=step;modalSteps.appendChild(li);});modal.classList.add('active');document.body.style.overflow='hidden';}
    projects.forEach(project=>{const card=document.createElement('div');card.className='card project-card';card.innerHTML=`<div class="project-top"></div><div class="project-icon">${project.icon}</div><h4>${project.title}</h4><p>${project.short}</p><div class="tool-row">${project.tools.map(tool=>`<span class="tool">${tool}</span>`).join('')}</div><span class="view-link">View Project →</span>`;card.addEventListener('click',()=>openProject(project));projectGrid.appendChild(card);});
    closeModal.addEventListener('click',()=>{modal.classList.remove('active');document.body.style.overflow='';});modal.addEventListener('click',(e)=>{if(e.target===modal){modal.classList.remove('active');document.body.style.overflow='';}});
  </script>
</body>
</html>
